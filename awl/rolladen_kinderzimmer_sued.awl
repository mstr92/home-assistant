
--M58	Istposition Rolladen (0–100)
--M59	API Befehl (1=Hoch, 2=Runter, 5=Stop)
--M60	Ziel Position (-1 = deaktiviert)
--M61	Zustand (State Machine)
--M62	Watchdog Zähler
--M63	Flankenspeicher

-- =========================================
-- ROLLADEN STEUERUNG
-- Kinderzimmer West — M58–M63 / UniversalAktor Q15-Q16
-- =========================================

local ROLLADEN_STEP = 0.96  -- Anpassen: 100 / Laufzeit_in_Sekunden
local TOL = 0.2

-- Flankenerkennung
if T5 == 1 and M63 == 0 then

  -- Sicherheitsabschaltung
  UniversalAktor#Q15 = 0
  UniversalAktor#Q16 = 0

  -- =====================================
  -- STOP
  -- =====================================
  if M59 == 5 then
      M61 = 0
      M59 = 0
  end

  -- =====================================
  -- API DIREKTBEFEHL
  -- =====================================
  if M59 == 1 then
    M61 = 1
    M59 = 0
  end
  if M59 == 2 then
    M61 = 2
    M59 = 0
  end

  -- =====================================
  -- ZIELPOSITION
  -- =====================================
  if M60 >= 0 then
      if math.abs(M60 - M58) < TOL then
          M60 = -1
          M61 = 0
      else
          M61 = (M60 > M58) and 2 or 1
      end
  end

  -- =====================================
  -- ZUSTANDSMASCHINE
  -- =====================================
  if M61 == 1 then
      UniversalAktor#Q15 = 1
      M58 = M58 - ROLLADEN_STEP

  elseif M61 == 2 then
      UniversalAktor#Q16 = 1
      M58 = math.min(M58 + ROLLADEN_STEP, 100)

  elseif M61 == 9 then
      -- Referenzfahrt oben
      UniversalAktor#Q15 = 1
      M58 = 0
  end

  -- =====================================
  -- WATCHDOG (Motor Schutz)
  -- =====================================
  if M61 ~= 0 then
      M62 = M62 + 1
      if M62 > 500 then
          M61 = 0
          M62 = 0
      end
  else
      M62 = 0
  end

  -- Stop wenn ganz oben oder ganz unten
	if (M58 >= 100) then
   	M61 = 0
	end

	-- oben NICHT sofort stoppen → Überfahrt erlauben
	if (M58 <= -10) then   -- ca. 10% "Überfahrt"
   		M61 = 0
   		M58 = 0
	end
end

M63 = T5
