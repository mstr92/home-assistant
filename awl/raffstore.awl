-- ====================== Info ==========================

-- Position: Raffstore Wohnzimmer West,
-- Dauer: 38 Sekunden

-- M13 = Istposition Behang (0–100)
-- M14 = Istposition Lamelle (0–100)

-- M15 = Sollposition Behang
-- M16 = Sollposition Lamelle

-- M17 = Fahrtrichtung (1 = hoch, -1 = runter, 0 = stop)
-- M18 = Modus (0 = Behang, 1 = Lamelle)

-- M19 = Hilfsmerker für Flankenerkennung von T5
-- T5  = Takt 100ms

-- Behang Schritt = 100 / (38 / 0.1) * 2 = 0.526
-- Lamellen Schritt = 100 / (1.4 / 0.1) * 2 = 14.28
-- ======================================================


-- Takt läuft permanent
T5 = 1

-- ====== Toleranz ======
local tolerance = 0.5

-- ====== Behang Richtung ======
if math.abs(M15 - M13) < tolerance then
  M13 = M15
  M17 = 0
else
  M17 = (M15 > M13) and 1 or -1
end

-- ====== Moduswahl ======
if M17 ~= 0 then
  M18 = 0
elseif math.abs(M16 - M14) >= tolerance then
  M18 = 1
else
  M18 = -1
end

-- ====== Bewegung ======
-- Flankenerkennung: nur ausführen bei steigender Flanke von T5
if (T5 == 1 and M19 == 0) then

  -- alles aus
  UniversalAktor#Q5 = 0
  UniversalAktor#Q6 = 0

  if M18 == 0 then
      if M17 == 1 then
          UniversalAktor#Q6 = 1
          M13 = math.min(M13 + 0.526, 100)
      elseif M17 == -1 then
          UniversalAktor#Q5 = 1
          M13 = math.max(M13 - 0.526, 0)
      end
  end

  if M18 == 1 then
      if M16 > M14 then
          UniversalAktor#Q6 = 1
          M14 = math.min(M14 + 14.28, 100, M16)
      elseif M16 < M14 then
          UniversalAktor#Q5 = 1
          M14 = math.max(M14 - 14.28, 0, M16)
      end
  end
end

-- Merker für nächsten Zyklus aktualisieren
M19 = T5
